---
// ============================================================
// Header. shared navigation, sticky, with brand + nav + CTA
// ============================================================

import RMark from './RMark.astro';

const { activePage = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home', slug: 'home' },
  { href: '/pages/services.html', label: 'Services', slug: 'services' },
  { href: '/pages/portfolio.html', label: 'Work', slug: 'portfolio' },
  { href: '/pages/about.html', label: 'Studio', slug: 'about' },
  { href: '/pages/blog.html', label: 'Journal', slug: 'blog' },
  { href: '/pages/contact.html', label: 'Contact', slug: 'contact' },
];
---

<header class="site-header" id="siteHeader">
  <a href="/" class="brand" data-magnetic>
    <RMark size="sm" />
    <span class="brand-text">
      <span>PRIMENEST</span>
      <span class="sub">Digitals</span>
    </span>
  </a>
  <nav>
    <ul class="nav-list">
      {navItems.map(item => (
        <li>
          <a href={item.href} aria-current={activePage === item.slug ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <a href="/pages/contact.html" class="nav-cta" data-magnetic>
    Book a call <span class="nav-cta-arrow">→</span>
  </a>
  <button class="hamburger" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>

  <!-- Mobile menu drawer -->
  <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>
  <nav class="mobile-menu-drawer" id="mobileMenuDrawer" aria-label="Mobile navigation">
    <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close menu">✕</button>
    <ul>
      <li><a href="/" aria-current={activePage === 'home' ? 'page' : undefined}>Home</a></li>
      <li><a href="/pages/services.html" aria-current={activePage === 'services' ? 'page' : undefined}>Services</a></li>
      <li><a href="/pages/portfolio.html" aria-current={activePage === 'portfolio' ? 'page' : undefined}>Work</a></li>
      <li><a href="/pages/about.html" aria-current={activePage === 'about' ? 'page' : undefined}>Studio</a></li>
      <li><a href="/pages/blog.html" aria-current={activePage === 'blog' ? 'page' : undefined}>Journal</a></li>
      <li><a href="/pages/contact.html" aria-current={activePage === 'contact' ? 'page' : undefined}>Contact</a></li>
    </ul>
    <a href="/pages/contact.html" class="mobile-menu-cta">Book a call →</a>
    <div class="mobile-menu-socials">
      <a href="https://www.instagram.com/hazeem.garuba/" target="_blank" rel="noopener" aria-label="Instagram">in</a>
      <a href="https://www.linkedin.com/in/garuba-hazeem-366415283/" target="_blank" rel="noopener" aria-label="LinkedIn">li</a>
      <a href="https://www.behance.net/garubahazeem-digital" target="_blank" rel="noopener" aria-label="Behance">Be</a>
      <a href="https://wa.me/13653751409" target="_blank" rel="noopener" aria-label="WhatsApp">wa</a>
    </div>
  </nav>
</header>
