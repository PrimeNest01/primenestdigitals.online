---
// ============================================================
// R Mark — Real 3D logo image
// Sizes: sm (28px), md (40px), lg (64px), xl (120px)
// ============================================================

const { size = 'sm', className = '' } = Astro.props;
const sizeMap = { sm: 28, md: 40, lg: 64, xl: 120 };
const px = sizeMap[size] || 28;
---

<img
  src="/r-mark.png"
  alt="PrimeNest Digitals logo"
  width={px}
  height={px}
  class={`r-mark-img r-mark-${size} ${className}`}
  loading="eager"
/>

<style is:global>
.r-mark-img{
  display:inline-block;
  border-radius:8px;
  box-shadow:0 0 24px rgba(139,92,246,0.35),inset 0 1px 0 rgba(255,255,255,0.25);
  object-fit:cover;
  flex-shrink:0;
}
.r-mark-sm{width:28px;height:28px}
.r-mark-md{width:40px;height:40px}
.r-mark-lg{width:64px;height:64px}
.r-mark-xl{width:120px;height:120px}

/* Watermark variant (footer) */
.r-watermark{
  position:absolute;
  bottom:-40px;right:-20px;
  width:280px !important;height:280px !important;
  opacity:0.04;
  pointer-events:none;
  z-index:0;
  box-shadow:none;
}
</style>
