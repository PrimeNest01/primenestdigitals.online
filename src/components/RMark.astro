---
// ============================================================
// R Mark — Reusable brand logo component
// Sizes: sm (28px), md (40px), lg (64px), xl (120px)
// ============================================================

const { size = 'sm', className = '' } = Astro.props;
---

<span class={`r-mark ${size} ${className}`} aria-hidden="true"></span>

<style is:global>
.r-mark{
  display:inline-block;
  background:linear-gradient(135deg,#7C3AED 0%,#A855F7 100%);
  border-radius:8px;
  position:relative;
  box-shadow:0 0 24px rgba(139,92,246,0.35),inset 0 1px 0 rgba(255,255,255,0.25);
  overflow:hidden;
  flex-shrink:0;
}
.r-mark::before{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,rgba(255,255,255,0.25) 0%,transparent 50%);
  border-radius:8px;
}
.r-mark::after{
  content:'R';
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:'Poppins','Inter',sans-serif;
  font-weight:700;
  color:#fff;
  text-shadow:0 1px 2px rgba(0,0,0,0.3);
}
.r-mark.sm{width:28px;height:28px}
.r-mark.sm::after{font-size:18px}
.r-mark.md{width:40px;height:40px}
.r-mark.md::after{font-size:26px}
.r-mark.lg{width:64px;height:64px}
.r-mark.lg::after{font-size:42px}
.r-mark.xl{width:120px;height:120px}
.r-mark.xl::after{font-size:80px}
</style>
