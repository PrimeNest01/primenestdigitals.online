---

<footer class="site-footer">
  <RMark size="lg" className="r-watermark" />
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand-block">
        <div class="footer-brand-mark">
          <RMark size="md" />
          <span>PRIMENEST<br><span class="sub">DIGITALS</span></span>
        </div>
        <p class="footer-brand-blurb">
          Marketing with a mechanism. A focused digital studio building revenue
          systems for construction, ecommerce, and service businesses across
          the US, Canada, and the UK.
        </p>
        <div class="footer-social">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener" class="social-btn" aria-label={s.name}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="14" height="14" set:html={s.svg} />
            </a>
          ))}
        </div>
      </div>
      <div class="footer-col">
        <h4>Studio</h4>
        <ul>
          <li><a href="/pages/about.html">About</a></li>
          <li><a href="/pages/contact.html">Contact</a></li>
          <li><a href="/pages/portfolio.html">Portfolio</a></li>
          <li><a href="/pages/blog.html">Journal</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="/pages/services/meta-ads/index.html">Meta Ads</a></li>
          <li><a href="/pages/services/google-ads/index.html">Google Ads</a></li>
          <li><a href="/pages/services/seo/index.html">SEO</a></li>
          <li><a href="/pages/services/website-design/index.html">Web Design</a></li>
          <li><a href="/pages/services.html">All services →</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Elsewhere</h4>
        <ul>
          <li><a href="https://www.behance.net/garubahazeem-digital" target="_blank" rel="noopener">Behance Portfolio</a></li>
          <li><a href="mailto:hazeem@primenestdigitals.online">hazeem@primenestdigitals.online</a></li>
          <li><a href="tel:+13653751409">+1 365-375-1409</a></li>
          <li><a href="https://go.primenestdigitals.online/book-a-strategic-call" target="_blank" rel="noopener">Book a call</a></li>
          <li><a href="/sitemap.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© {year} PrimeNest Digitals · Marketing with a mechanism</div>
      <div class="footer-legal">
        <a href="/pages/privacy.html">Privacy</a>
        <a href="/pages/terms.html">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
.r-watermark{
  position:absolute;bottom:-40px;right:-20px;width:280px;height:280px;
  opacity:0.10;pointer-events:none;z-index:0;
}
.r-watermark::after{font-size:200px !important}

.footer-social{display:flex;gap:8px;margin-top:14px}
.social-btn{
  width:34px;height:34px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(139,92,246,0.08);color:rgba(255,255,255,0.6);
  border:1px solid rgba(255,255,255,0.08);
  transition:all 0.3s;
}
.social-btn:hover{
  background:linear-gradient(135deg,#7C3AED 0%,#A855F7 100%);
  color:#fff;border-color:transparent;
  transform:translateY(-2px);
  box-shadow:0 8px 16px rgba(139,92,246,0.3);
}
</style>
