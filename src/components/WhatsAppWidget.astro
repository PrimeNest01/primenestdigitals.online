      Start WhatsApp Chat
    </a>
  </div>
  <button class="wa-pill" id="waPill" aria-label="Open WhatsApp chat">
    <div class="wa-pill-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </div>
    <span class="wa-pill-text">Chat with Hazeem</span>
    <span class="wa-pill-dot"></span>
  </button>
</div>

<style is:global>
.wa-widget{position:fixed;bottom:24px;left:24px;z-index:200;font-family:'Inter',sans-serif}
.wa-pill{
  display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg,#7C3AED 0%,#A855F7 100%);
  color:#fff;border:none;border-radius:100px;padding:12px 18px;
  font-size:13px;font-weight:600;cursor:pointer;
  box-shadow:0 8px 24px rgba(139,92,246,0.4),0 0 0 1px rgba(255,255,255,0.1) inset;
  transition:transform 0.3s,box-shadow 0.3s;
}
.wa-pill:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(139,92,246,0.5)}
.wa-pill-icon{display:flex;align-items:center;justify-content:center}
.wa-pill-dot{width:8px;height:8px;background:#22c55e;border-radius:50%;box-shadow:0 0 0 0 rgba(34,197,94,0.7);animation:wa-pulse 2s infinite}
@keyframes wa-pulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,0.7)}70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
.wa-card{
  position:absolute;bottom:64px;left:0;width:340px;
  background:var(--black-2,#111);border:1px solid rgba(139,92,246,0.3);border-radius:16px;
  padding:20px;display:none;flex-direction:column;gap:14px;
  box-shadow:0 20px 60px rgba(0,0,0,0.6),0 0 0 1px rgba(255,255,255,0.05);
}
.wa-card.open{display:flex;animation:wa-card-in 0.3s cubic-bezier(0.22,1,0.36,1)}
@keyframes wa-card-in{from{opacity:0;transform:translateY(20px) scale(0.95)}to{opacity:1;transform:translateY(0) scale(1)}}
.wa-card-header{display:flex;align-items:center;gap:12px}
.wa-card-brand{flex-shrink:0}
.wa-card-name{font-family:'Fraunces',serif;font-weight:600;font-size:15px;color:#fff;letter-spacing:-0.01em}
.wa-card-status{font-size:11px;color:rgba(255,255,255,0.55);display:flex;align-items:center;gap:6px}
.wa-status-dot{width:7px;height:7px;background:#22c55e;border-radius:50%;display:inline-block}
.wa-close{position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.06);border:none;color:rgba(255,255,255,0.55);width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;transition:background 0.2s,color 0.2s}
.wa-close:hover{background:rgba(255,255,255,0.1);color:#fff}
.wa-card-msg{font-size:13px;color:rgba(255,255,255,0.72);line-height:1.55;margin:0}
.wa-card-msg strong{color:#fff;font-weight:600}
.wa-card-cta{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:#25D366;color:#fff;text-decoration:none;
  padding:12px 18px;border-radius:8px;font-size:13px;font-weight:600;
  transition:background 0.2s,transform 0.2s;
}
.wa-card-cta:hover{background:#1da851;transform:translateY(-1px)}
@media(max-width:600px){.wa-card{width:calc(100vw - 48px);max-width:340px}}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var pill = document.getElementById('waPill');
    var card = document.getElementById('waCard');
    var close = document.getElementById('waClose');
    if (!pill || !card) return;
    pill.addEventListener('click', function() { card.classList.toggle('open'); });
    if (close) {
      close.addEventListener('click', function() { card.classList.remove('open'); });
    }
    // Close on outside click
    document.addEventListener('click', function(e) {
      if (!card.contains(e.target) && !pill.contains(e.target)) card.classList.remove('open');
    });
  });
</script>
