---
// ============================================================
// PopupForm. animated modal with Systeme.io form
// Pops in 5 seconds after page load (once per session)
// Skips on contact page (form already there)
// ============================================================
---

<div class="popup-overlay" id="popupOverlay" aria-hidden="true">
  <div class="popup-modal" id="popupModal" role="dialog" aria-modal="true" aria-labelledby="popupTitle">
    <button class="popup-close" id="popupClose" aria-label="Close">✕</button>

    <!-- R mark pops in first -->
    <div class="popup-logo-wrap">
      <span class="r-mark lg popup-logo"></span>
      <span class="popup-logo-pulse"></span>
    </div>

    <!-- Headline -->
    <div class="popup-headline">
      <div class="popup-eyebrow">Free Marketing Audit</div>
      <h2 class="popup-title" id="popupTitle">Want to know <em>exactly</em> where your marketing is leaking?</h2>
      <p class="popup-blurb">Hazeem personally reviews your ads, funnel, email, and SEO. You get a written audit within 48 hours. No pitch. No obligation. You keep the notes either way.</p>
    </div>

    <!-- Trust badges -->
    <div class="popup-trust">
      <div class="popup-trust-item"><span class="popup-trust-num">$526K</span><span class="popup-trust-label">Revenue</span></div>
      <div class="popup-trust-item"><span class="popup-trust-num">12.87X</span><span class="popup-trust-label">ROAS</span></div>
      <div class="popup-trust-item"><span class="popup-trust-num">30</span><span class="popup-trust-label">Projects</span></div>
      <div class="popup-trust-item"><span class="popup-trust-num">48h</span><span class="popup-trust-label">Delivery</span></div>
    </div>

    <!-- Systeme.io form embed -->
    <div class="popup-form-wrap" id="popup-systemeio-embed-wrap">
      <script is:inline src="https://hazeem-orm-solution.systeme.io/public/remote/page/441003282c274cd97b0cdd0bbcca5de662646cc6.js"></script>
    </div>

    <!-- Alternative -->
    <div class="popup-alt">
      <span>Prefer to talk? </span>
      <a href="https://go.primenestdigitals.online/book-a-strategic-call" target="_blank" rel="noopener">Book a 30-min call →</a>
    </div>
  </div>
</div>

<style is:global>
/* POPUP OVERLAY. backdrop with blur */
.popup-overlay{
  position:fixed;inset:0;z-index:300;
  background:rgba(10,10,10,0.78);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  opacity:0;pointer-events:none;
  transition:opacity 0.4s ease;
  display:flex;align-items:center;justify-content:center;
  padding:20px;
}
.popup-overlay.active{
  opacity:1;pointer-events:auto;
}

/* MODAL. scales + slides up */
.popup-modal{
  position:relative;
  width:100%;max-width:520px;
  max-height:90vh;overflow-y:auto;
  background:linear-gradient(180deg,#111 0%,#0A0A0A 100%);
  border:1px solid rgba(139,92,246,0.3);
  border-radius:18px;
  padding:36px 32px 28px;
  box-shadow:0 30px 80px rgba(0,0,0,0.6),0 0 0 1px rgba(255,255,255,0.05) inset,0 0 60px rgba(139,92,246,0.15);
  transform:translateY(40px) scale(0.92);
  opacity:0;
  transition:transform 0.55s cubic-bezier(0.22,1,0.36,1),opacity 0.4s ease;
}
.popup-overlay.active .popup-modal{
  transform:translateY(0) scale(1);
  opacity:1;
}

/* Close button */
.popup-close{
  position:absolute;top:14px;right:14px;
  width:32px;height:32px;border-radius:8px;
  background:rgba(255,255,255,0.06);border:none;
  color:rgba(255,255,255,0.55);font-size:14px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background 0.2s,color 0.2s,transform 0.2s;
  z-index:2;
}
.popup-close:hover{
  background:rgba(139,92,246,0.18);
  color:#fff;
  transform:rotate(90deg);
}

/* Logo with pulse animation */
.popup-logo-wrap{
  position:relative;
  width:80px;height:80px;margin:0 auto 24px;
}
.popup-logo{
  width:80px !important;height:80px !important;
  border-radius:18px !important;
  filter:drop-shadow(0 0 24px rgba(139,92,246,0.5));
  animation:popup-logo-in 0.7s 0.2s cubic-bezier(0.34,1.56,0.64,1) both;
}
.popup-logo::after{font-size:52px !important}
.popup-overlay.active .popup-logo-pulse{
  position:absolute;inset:0;
  border:2px solid #8B5CF6;border-radius:18px;
  animation:popup-pulse 1.2s 0.6s ease-out infinite;
}
@keyframes popup-logo-in{
  0%{transform:scale(0) rotate(-180deg);opacity:0}
  60%{transform:scale(1.15) rotate(10deg);opacity:1}
  100%{transform:scale(1) rotate(0);opacity:1}
}
@keyframes popup-pulse{
  0%{transform:scale(1);opacity:0.7}
  100%{transform:scale(1.6);opacity:0}
}

/* Headline */
.popup-headline{
  text-align:center;margin-bottom:24px;
  animation:popup-fade-up 0.6s 0.5s cubic-bezier(0.22,1,0.36,1) both;
}
.popup-eyebrow{
  font-size:11px;letter-spacing:0.25em;text-transform:uppercase;
  color:#8B5CF6;margin-bottom:10px;font-weight:600;
}
.popup-title{
  font-family:'Fraunces',serif;font-weight:300;
  font-size:clamp(24px,4vw,32px);line-height:1.15;letter-spacing:-0.03em;
  color:#fff;margin-bottom:12px;
}
.popup-title em{font-style:italic;color:#8B5CF6;font-variation-settings:'opsz' 144}
.popup-blurb{
  font-size:14px;color:rgba(255,255,255,0.62);line-height:1.6;max-width:380px;margin:0 auto;
}

/* Trust badges row */
.popup-trust{
  display:grid;grid-template-columns:repeat(4,1fr);gap:8px;
  margin-bottom:24px;padding:14px 0;
  border-top:1px solid rgba(255,255,255,0.08);border-bottom:1px solid rgba(255,255,255,0.08);
  animation:popup-fade-up 0.6s 0.7s cubic-bezier(0.22,1,0.36,1) both;
}
.popup-trust-item{
  text-align:center;display:flex;flex-direction:column;gap:2px;
}
.popup-trust-num{
  font-family:'JetBrains Mono',monospace;font-size:16px;color:#8B5CF6;font-weight:500;
}
.popup-trust-label{
  font-size:9px;letter-spacing:0.15em;text-transform:uppercase;
  color:rgba(255,255,255,0.4);
}

/* Form wrapper */
.popup-form-wrap{
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:12px;
  padding:16px;min-height:300px;
  margin-bottom:20px;
  animation:popup-fade-up 0.6s 0.9s cubic-bezier(0.22,1,0.36,1) both;
}
.popup-form-wrap iframe,.popup-form-wrap form{
  width:100% !important;
}

/* Alternative CTA */
.popup-alt{
  text-align:center;font-size:12px;color:rgba(255,255,255,0.45);
  animation:popup-fade-up 0.6s 1.1s cubic-bezier(0.22,1,0.36,1) both;
}
.popup-alt a{
  color:#8B5CF6;text-decoration:none;font-weight:600;
  transition:color 0.2s;
}
.popup-alt a:hover{color:#A855F7}

@keyframes popup-fade-up{
  from{opacity:0;transform:translateY(20px)}
  to{opacity:1;transform:translateY(0)}
}

/* Mobile */
@media(max-width:600px){
  .popup-modal{padding:28px 20px 20px;border-radius:14px}
  .popup-title{font-size:22px}
  .popup-blurb{font-size:13px}
  .popup-trust{grid-template-columns:repeat(2,1fr);gap:12px;padding:14px 0}
}

/* Reduced motion */
@media(prefers-reduced-motion:reduce){
  .popup-modal,.popup-logo,.popup-headline,.popup-trust,.popup-form-wrap,.popup-alt{
    animation:none !important;
    transition:opacity 0.2s ease !important;
    transform:none !important;
  }
}
</style>

<script>
  (function(){
    // Don't show on contact page (form already there)
    if (window.location.pathname.includes('/pages/contact')) return;

    // Don't show if user dismissed in this session
    if (sessionStorage.getItem('pn_popup_dismissed') === '1') return;

    // Wait for DOM
    document.addEventListener('DOMContentLoaded', function() {
      var overlay = document.getElementById('popupOverlay');
      var closeBtn = document.getElementById('popupClose');
      if (!overlay) return;

      // Show after 5 seconds
      setTimeout(function() {
        // Don't show if user is already interacting with WhatsApp or Free Audit panel
        var waCard = document.getElementById('waCard');
        var panel = document.getElementById('slidePanel');
        if ((waCard && waCard.classList.contains('open')) || (panel && panel.classList.contains('open'))) {
          // Retry in 10 seconds
          setTimeout(show, 10000);
          return;
        }
        show();
      }, 5000);

      function show() {
        overlay.classList.add('active');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function hide() {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = 'auto';
        sessionStorage.setItem('pn_popup_dismissed', '1');
      }

      // Close on button click
      if (closeBtn) closeBtn.addEventListener('click', hide);

      // Close on overlay click (outside modal)
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) hide();
      });

      // Close on Escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay.classList.contains('active')) hide();
      });
    });
  })();
</script>
