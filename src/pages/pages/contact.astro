---
// ============================================================
// Contact. /pages/contact.html
// ============================================================

import BaseLayout from '../../layouts/BaseLayout.astro';

const channels = [
  { icon: '📅', label: 'Book directly', value: 'Pick a 30-min slot on the calendar', href: 'https://go.primenestdigitals.online/book-a-strategic-call', external: true },
  { icon: '💬', label: 'WhatsApp', value: 'Chat with Hazeem directly', href: '#', external: false },
  { icon: '✉', label: 'Email', value: 'hello@primenestdigitals.online', href: 'mailto:hello@primenestdigitals.online', external: false },
  { icon: 'in', label: 'LinkedIn', value: 'Connect with Hazeem', href: '#', external: false },
];
---

<BaseLayout
  title="Contact. Free Marketing Audit · PrimeNest Digitals"
  description="Book a free 30-minute audit. No pitch, no agency handoff. Just an honest read on what's working and what's leaking."
  activePage="contact"
>
  <section class="page-hero">
    <div class="page-hero-grid">
      <div>
        <div class="breadcrumbs"><a href="/">Home</a><span class="sep">/</span><span>Contact</span></div>
        <h1 class="page-hero-title">No pitch. No agency handoff. <em>Just honest help</em>.</h1>
      </div>
      <div class="page-hero-meta">
        <p>30 minutes. We'll look at your current stack. paid, web, email, SEO. and tell you exactly where it's leaking and what we'd do first if you hired us. You keep the notes either way.</p>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-grid">
      <div class="contact-info">
        <h3 class="reveal">Three ways to <em>start the conversation</em>.</h3>
        <p class="reveal reveal-delay-1">Pick the one that feels easiest. They all end at the same place: a free audit, no obligation, no email sequence.</p>
        <div class="contact-channels reveal reveal-delay-2">
          {channels.map(c => (
            <a href={c.href} class="contact-channel" {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
              <div class="contact-channel-icon">{c.icon}</div>
              <div class="contact-channel-text">
                <div class="contact-channel-label">{c.label}</div>
                <div class="contact-channel-value">{c.value}</div>
              </div>
            </a>
          ))}
        </div>
        <div style="border-top:1px solid var(--line);padding-top:32px;margin-top:32px">
          <div class="section-label">Or fill the form</div>
          <p style="font-size:13px;color:var(--paper-2)">If you'd rather write it out first, the form below goes straight to Hazeem's inbox. We reply inside 24 hours, weekdays.</p>
        </div>
      </div>
      <div class="contact-form">
      <h4>Request a free audit</h4>
      <p style="font-size:13px;color:var(--paper-2);margin-bottom:24px">Fill out the form below and Hazeem will personally reply within 24 hours, weekdays. No bots, no account managers. just the founder.</p>
      <div id="systemeio-embed-wrap" style="min-height:400px">
        <script is:inline src="https://hazeem-orm-solution.systeme.io/public/remote/page/441003282c274cd97b0cdd0bbcca5de662646cc6.js"></script>
      </div>
    </div>
    </div>
  </section>
</BaseLayout>
