const filters = ['All work', 'Meta Ads', 'Google Ads', 'Email', 'Web Design', 'Funnels', 'SEO', 'Automation'];
---

<BaseLayout
  title="Portfolio — 30 Real Projects · PrimeNest Digitals"
  description="30 verified Behance projects across construction, ecommerce, and service businesses. Real campaigns, real results."
  activePage="portfolio"
>
  <section class="page-hero">
    <div class="page-hero-grid">
      <div>
        <div class="breadcrumbs"><a href="/">Home</a><span class="sep">/</span><span>Work</span></div>
        <h1 class="page-hero-title">30 real projects. All <em>verified on Behance</em>.</h1>
      </div>
      <div class="page-hero-meta">
        <p>Every project below is real, shipped, and verifiable on our Behance. No stock mockups, no fantasy case studies. Filter by category to find work like yours.</p>
      </div>
    </div>
  </section>

  <div class="portfolio-filters">
    <div class="portfolio-filters-inner">
      {filters.map((f, i) => (
        <button class={`portfolio-filter ${i === 0 ? 'active' : ''}`}>{f}</button>
      ))}
    </div>
  </div>

  <section style="padding:0">
    <div class="portfolio-grid">
      {projects.map(p => (
        <article class="portfolio-item" data-category={p.cat}>
          <div class="portfolio-thumb"><img src={`/portfolio/${p.image}`} alt={p.title} class="portfolio-thumb-img" loading="lazy" />
            <div class="portfolio-thumb-cat">{p.cat}</div>
            <div class="portfolio-thumb-r">R</div>
            <div class="portfolio-thumb-num">{p.num}</div>
          </div>
          <div class="portfolio-body">
            <h3 class="portfolio-title"><a href={p.behance} target="_blank" rel="noopener">{p.title}</a></h3>
            <div class="portfolio-meta">{p.meta}</div>
            <a href={p.behance} target="_blank" rel="noopener" class="portfolio-behance-link">View on Behance →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-inner">
      <div class="cta-eyebrow reveal">All projects verified</div>
      <h2 class="cta-title reveal reveal-delay-1">Want your project <em>in here</em>?</h2>
      <p class="cta-sub reveal reveal-delay-2">We onboard a maximum of three new clients per quarter. If you want to be one of them, the audit call is free and the slot is first-come.</p>
      <a href="/pages/contact.html" class="btn btn-primary reveal reveal-delay-3" data-magnetic>Book the call <span>→</span></a>
    </div>
  </section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var filters = document.querySelectorAll('.portfolio-filter');
    var items = document.querySelectorAll('.portfolio-item');

    filters.forEach(function(filter) {
      filter.addEventListener('click', function() {
        var category = this.textContent.trim();

        // Update active state
        filters.forEach(function(f) { f.classList.remove('active'); });
        this.classList.add('active');

        // Filter items
        items.forEach(function(item) {
          var itemCat = item.getAttribute('data-category');
          if (category === 'All work' || category === 'All posts' || itemCat === category) {
            item.style.display = '';
            item.style.opacity = '0';
            setTimeout(function() { item.style.opacity = '1'; }, 50);
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>

</BaseLayout>


<style is:global>
.portfolio-thumb-img{
  position:absolute;inset:0;
  width:100%;height:100%;
  object-fit:cover;
  z-index:1;
}
.portfolio-thumb-cat,
.portfolio-thumb-num,
.portfolio-thumb-r{
  position:relative;z-index:2;
}
.portfolio-thumb::before{
  background:linear-gradient(180deg,rgba(0,0,0,0.4) 0%,transparent 30%,rgba(0,0,0,0.6) 100%);
  z-index:2;
}
</style>
