const filters = ['All work', 'Meta Ads', 'Google Ads', 'Email', 'Web Design', 'Funnels', 'SEO', 'Automation'];
---

<BaseLayout
  title="Portfolio — 30 Real Projects · PrimeNest Digitals"
  description="30 verified Behance projects across construction, ecommerce, and service businesses. Real campaigns, real results."
  activePage="portfolio"
>
  <section class="page-hero">
    <div class="page-hero-grid">
      <div>
        <div class="breadcrumbs"><a href="/">Home</a><span class="sep">/</span><span>Work</span></div>
        <h1 class="page-hero-title">30 real projects. All <em>verified on Behance</em>.</h1>
      </div>
      <div class="page-hero-meta">
        <p>Every project below is real, shipped, and verifiable on our Behance. No stock mockups, no fantasy case studies. Filter by category to find work like yours.</p>
      </div>
    </div>
  </section>

  <div class="portfolio-filters">
    <div class="portfolio-filters-inner">
      {filters.map((f, i) => (
        <button class={`portfolio-filter ${i === 0 ? 'active' : ''}`}>{f}</button>
      ))}
    </div>
  </div>

  <section style="padding:0">
    <div class="portfolio-grid">
      {projects.map(p => (
        <article class="portfolio-item">
          <div class="portfolio-thumb">
            <div class="portfolio-thumb-cat">{p.cat}</div>
            <div class="portfolio-thumb-r">R</div>
            <div class="portfolio-thumb-num">{p.num}</div>
          </div>
          <div class="portfolio-body">
            <h3 class="portfolio-title">{p.title}</h3>
            <div class="portfolio-meta">{p.meta}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-inner">
      <div class="cta-eyebrow reveal">All projects verified</div>
      <h2 class="cta-title reveal reveal-delay-1">Want your project <em>in here</em>?</h2>
      <p class="cta-sub reveal reveal-delay-2">We onboard a maximum of three new clients per quarter. If you want to be one of them, the audit call is free and the slot is first-come.</p>
      <a href="/pages/contact.html" class="btn btn-primary reveal reveal-delay-3" data-magnetic>Book the call <span>→</span></a>
    </div>
  </section>
</BaseLayout>
