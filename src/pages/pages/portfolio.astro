  { num: '18', cat: 'Web Design', title: 'Service Business · WP', meta: 'WordPress · US' },
  { num: '19', cat: 'Automation', title: 'CRM + AI Pipeline', meta: 'GHL + ChatGPT · CA' },
  { num: '20', cat: 'Meta Ads', title: 'Skincare · Retargeting', meta: 'Retargeting · UK' },
  { num: '21', cat: 'Google Ads', title: 'Service Business · Search', meta: 'Search · US' },
  { num: '22', cat: 'Email', title: 'Beauty Launch Email', meta: '3 flows · UK' },
  { num: '23', cat: 'Funnels', title: 'Tripwire Sequence', meta: 'Ecommerce · US' },
  { num: '24', cat: 'Web Design', title: 'Shopify Store · Beauty', meta: 'Full store · UK' },
