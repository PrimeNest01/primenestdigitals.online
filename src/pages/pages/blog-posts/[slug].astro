---
// ============================================================
// Blog Post — /pages/blog-posts/[slug].html (× 12)
// Uses blog-posts.js data + blog post content from inline body
// ============================================================

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { blogPosts, getRelatedPosts } from '../../../data/blog-posts.js';

export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const related = getRelatedPosts(post.slug, 3);

---

<BaseLayout
  title={`${post.title} — PrimeNest`}
  description={post.excerpt}
  activePage="blog"
>
  <section class="post-hero">
    <div class="post-hero-inner">
      <div class="post-tag">{post.category}</div>
      <h1 class="post-title" set:html={post.title.replace(/\b(Running|Not Coming|Working|Wasting|Dominate)\b/g, '<em>$1</em>')} />
      <p class="post-excerpt">{post.excerpt}</p>
      <div class="post-meta">
        <span class="author">
          <span class="avatar">{post.authorInitials}</span> {post.author}
        </span>
        <span class="dot" style="width:3px;height:3px;background:var(--paper-2);border-radius:50%"></span>
        <span>{post.readingTime}</span>
        <span class="dot" style="width:3px;height:3px;background:var(--paper-2);border-radius:50%"></span>
        <span>{post.publishedAt}</span>
      </div>
    </div>
  </section>

  <section class="post-body">
    <div class="post-body-inner">
      <aside class="post-toc">
        <h5>On this page</h5>
        <p style="font-size:13px;color:var(--paper-2);line-height:1.6">Scroll to read the full article. Use the table of contents above each section to navigate.</p>
      </aside>
      <article class="post-content" set:html={post.bodyContent} />
    </div>
  </section>

  <section class="post-footer">
    <div class="post-footer-inner">
      <div class="post-share">
        <span>Share:</span>
        <a href="#">LinkedIn</a>
        <a href="#">Twitter</a>
        <a href="#">Copy link</a>
      </div>
      <div style="display:flex;align-items:center;gap:12px">
        <span class="avatar" style="width:32px;height:32px;font-size:11px">{post.authorInitials}</span>
        <div>
          <div style="font-size:13px;color:var(--white)">{post.author}</div>
          <div style="font-size:11px;color:var(--paper-2)">Founder · Lead Strategist</div>
        </div>
      </div>
    </div>
  </section>

  <section class="related-posts">
    <div class="related-posts-inner">
      <h3 class="reveal">Related <em>reading</em>.</h3>
      <div class="blog-list-grid">
        {related.map((r, i) => (
          <article class={`blog-card reveal ${i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : ''}`}>
            <a href={`/pages/blog-posts/${r.slug}.html`}><div class="blog-card-img"></div></a>
            <div class="blog-tag">{r.category}</div>
            <a href={`/pages/blog-posts/${r.slug}.html`}><h3 class="blog-card-title">{r.title}</h3></a>
            <p class="blog-card-excerpt">{r.excerpt}</p>
            <div class="blog-card-meta">
              <span>{r.readingTime}</span>
              <span class="dot"></span>
              <span>{r.publishedAt}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
