---
// ============================================================
// About Page. /pages/about.html
// ============================================================

import BaseLayout from '../../layouts/BaseLayout.astro';

const values = [
  { num: '01', title: 'One strategist, start to finish.', desc: 'No account managers handing you between juniors. The person who built your strategy is the person who optimises it on Friday at 4 p.m. and reports on it Monday at 9 a.m.' },
  { num: '02', title: 'Numbers before narrative.', desc: 'If we can\'t measure it, we don\'t sell it. Every recommendation ties back to a tracked metric. revenue, ROAS, CPL, pipeline. Pretty dashboards without numbers are not the work.' },
  { num: '03', title: 'Systems, not campaigns.', desc: 'A campaign ends. A mechanism compounds. We build the ad account, the funnel, the email flow, and the CRM automation as one machine. not four disconnected line items.' },
];

const timeline = [
  { year: '2024', title: 'The first client.', body: 'Roofing company in Victoria, BC. Six-week rebuild of their Google Ads, landing page, and follow-up flow. The referral loop started here.' },
  { year: '2024 Q3', title: 'First ecommerce client.', body: 'A skincare brand with strong product, weak funnel. Built the system that eventually became the $526K case study.' },
  { year: '2025 Q1', title: 'Crossed into the US and UK.', body: 'First contractor in Texas. First beauty brand in London. Same model, three time zones.' },
  { year: '2025 Q4', title: 'The studio formalises.', body: 'Ajayi joins for delivery and QA. Behance portfolio hits 30 verified projects. Sitemap formalised.' },
  { year: '2026', title: 'The next chapter.', body: 'Rebuilt studio website, formalised the four-pillar service model, opened intake for three new client slots.' },
];
---

<BaseLayout
  title="About. PrimeNest Digitals"
  description="The studio behind the revenue systems. Founder Hazeem Garuba, the story, the values, and the people."
  activePage="about"
>
  <section class="page-hero">
    <div class="page-hero-grid">
      <div>
        <div class="breadcrumbs"><a href="/">Home</a><span class="sep">/</span><span>Studio</span></div>
        <h1 class="page-hero-title">The studio behind the <em>mechanism</em>.</h1>
      </div>
      <div class="page-hero-meta">
        <p>A focused team that built its first revenue system for a construction client in 2024. Two years later, the same person is still on the call. and the same rigor is still on the page.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div style="display:grid;grid-template-columns:1fr;gap:48px">
        <div>
          <div class="section-label">The story</div>
          <h2 class="section-title reveal" style="max-width:none">Started with one <em>construction client</em>. Grew into a studio by referral.</h2>
        </div>
        <div style="display:grid;grid-template-columns:1fr;gap:24px;max-width:680px">
          <p class="reveal" style="font-size:17px;line-height:1.7;color:var(--paper)">Hazeem Garuba started PrimeNest Digitals in 2024 after eight years inside performance marketing agencies. watching clients get bounced between account managers, sold deliverables they didn't need, and billed for strategy that was actually just template work. He built PrimeNest as the opposite of that.</p>
          <p class="reveal reveal-delay-1" style="font-size:15px;line-height:1.7;color:var(--paper)">The first client was a roofing company in Victoria, BC. They'd been burned by two agencies before. We rebuilt their Google Ads account, their landing page, and their follow-up flow in six weeks. They went from one inbound lead a week to four a day. Every client since has come from that first one.</p>
          <p class="reveal reveal-delay-2" style="font-size:15px;line-height:1.7;color:var(--paper)">Today the studio works with construction companies, ecommerce brands, and service businesses across the US, Canada, and the UK. Same model: one strategist from first call to last report. No juniors. No freelancers. No agency handoff.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--black-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="section-inner">
      <div style="margin-bottom:64px">
        <div class="section-label">What we believe</div>
        <h2 class="section-title reveal">Three <em>principles</em> we don't bend on.</h2>
      </div>
      <div class="values-grid">
        {values.map(v => (
          <article class={`value-card reveal ${v.num === '02' ? 'reveal-delay-1' : v.num === '03' ? 'reveal-delay-2' : ''}`}>
            <div class="value-num">{v.num}</div>
            <h3 class="value-title">{v.title}</h3>
            <p class="value-desc">{v.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div style="margin-bottom:64px">
        <div class="section-label">The path here</div>
        <h2 class="section-title reveal">Four years, one <em>accountable</em> team.</h2>
      </div>
      <div class="timeline">
        {timeline.map(t => (
          <div class="timeline-row reveal">
            <div class="timeline-year">{t.year}</div>
            <div class="timeline-content">
              <h4>{t.title}</h4>
              <p>{t.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--black-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="founder-note">
      <div class="founder-note-card reveal">
        <div class="founder-photo-wrap">
          <img class="founder-photo" src="/founder-hazeem.jpg" alt="Hazeem Garuba. Founder" width="120" height="120" />
          <div style="text-align:center">
            <div class="founder-photo-name">Hazeem Garuba</div>
            <div class="founder-photo-role">Founder · Lead Strategist</div>
          </div>
          <div class="team-card-skills" style="justify-content:center">
            <span class="team-skill">Meta Ads</span><span class="team-skill">Google Ads</span><span class="team-skill">Klaviyo</span><span class="team-skill">GoHighLevel</span><span class="team-skill">Funnels</span>
          </div>
        </div>
        <div class="founder-note-body">
          <p>"Eight years inside performance marketing agencies taught me one thing: clients don't want more meetings, more decks, more junior account managers. They want the person who actually does the work. on the call, in the account, on the page."</p>
          <p style="font-size:16px;color:var(--paper);font-style:normal;font-family:Inter,sans-serif;font-weight:400;line-height:1.7;margin-top:24px">That's what PrimeNest is. One strategist from first call to last report. The work is the proof; the relationship is the product. If that's what you're looking for, we should talk.</p>
          <div class="founder-signature">
            <div class="founder-sig-name">- Hazeem</div>
            <div class="founder-sig-meta">Founder · PrimeNest Digitals</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="team-section">
    <div class="team-inner">
      <div class="team-header">
        <div>
          <div class="section-label">The people</div>
          <h2 class="section-title reveal">Small on purpose. <em>Senior</em> by design.</h2>
        </div>
        <p class="services-intro reveal reveal-delay-1">No account managers handing you between juniors. The person on your first call is the person on your 200th.</p>
      </div>
      <div class="team-grid">
        <article class="team-card founder reveal">
          <img class="team-card-photo" src="/founder-hazeem.jpg" alt="Hazeem Garuba. Founder" width="80" height="80" />
          <div><div class="team-card-name">Hazeem Garuba</div><div class="team-card-role">Founder · Lead Strategist</div></div>
          <p class="team-card-bio">Eight years in performance marketing across construction, ecommerce, and home services. Personally oversees every Meta Ads account, every funnel, every CRM automation. The buck stops here, and so does the strategy.</p>
          <div class="team-card-skills">
            <span class="team-skill">Meta Ads</span><span class="team-skill">Google Ads</span><span class="team-skill">Klaviyo</span>
            <span class="team-skill">GoHighLevel</span><span class="team-skill">SEO</span><span class="team-skill">Funnels</span><span class="team-skill">ChatGPT</span>
          </div>
          <div class="team-card-social">
            <a href="https://www.linkedin.com" target="_blank" rel="noopener">LinkedIn →</a>
            <a href="https://www.instagram.com" target="_blank" rel="noopener">Instagram →</a>
            <a href="/pages/contact.html">Email →</a>
          </div>
        </article>
        <article class="team-card reveal reveal-delay-1">
          <img class="team-card-photo" src="/team-ajayi.png" alt="Ajayi E.. Delivery" width="80" height="80" />
          <div><div class="team-card-name">Ajayi E.</div><div class="team-card-role">Delivery</div></div>
          <p class="team-card-bio">Specialises in execution. design QA, email QA, landing page QA. Every campaign that ships passes through this desk before it goes live.</p>
          <div class="team-card-social">
            <a href="https://www.linkedin.com" target="_blank" rel="noopener">LinkedIn →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-inner">
      <div class="cta-eyebrow reveal">Open intake</div>
      <h2 class="cta-title reveal reveal-delay-1">Three client slots open for <em>Q4 2026</em>.</h2>
      <p class="cta-sub reveal reveal-delay-2">We take on a maximum of three new clients per quarter so the founder stays in the work. If you're considering hiring us, the conversation is free and the slot is first-come.</p>
      <a href="/pages/contact.html" class="btn btn-primary reveal reveal-delay-3" data-magnetic>Book the call <span>→</span></a>
    </div>
  </section>
</BaseLayout>
